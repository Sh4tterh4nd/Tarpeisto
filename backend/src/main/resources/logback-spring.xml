<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <!--
      Human-readable console output for local development, including the request/trace ID
      correlation set by io.kellermann.tarpeisto.config.RequestCorrelationFilter.
    -->
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%X{traceId:-},%X{requestId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!--
      Structured JSON console output everywhere else (production and CI), using Spring Boot's
      built-in structured logging support (no extra dependency required). The ECS format
      includes MDC entries automatically, so the request/trace ID set by
      RequestCorrelationFilter is present on every log line.
    -->
    <springProfile name="!dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
                <format>ecs</format>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
