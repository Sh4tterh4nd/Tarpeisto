# BigContainers Compose environment file.
#
# Copy this file to `.env` in this same directory and fill in real values.
# `.env` is covered by the repository .gitignore (`.env`, `.env.*`, with an
# explicit `!.env.example` exception) and must never be committed.
#
#   cp .env.example .env
#
# All values below are safe, non-secret defaults or obvious placeholders.
# Replace every CHANGE_ME before running against real data.

# --- Compose profiles -------------------------------------------------------
# Garage (bundled S3-compatible object storage) is started by default because
# the "garage" profile is active here. To use an external S3-compatible
# endpoint instead, either delete this line or set it to an empty value, then
# set the BIGCONTAINERS_S3_* variables below to point at that external
# service. See README.md.
COMPOSE_PROFILES=garage

# --- Application image -------------------------------------------------------
# Single variable controlling the published application image, tag, or
# digest. For production, pin an exact semantic version
# (ghcr.io/sh4tterh4nd/bigcontainers:1.2.3) or an image digest
# (ghcr.io/sh4tterh4nd/bigcontainers@sha256:...) rather than :main or
# :latest, so upgrades are explicit and reproducible. See README.md
# "Pinning the application image".
BIGCONTAINERS_IMAGE=ghcr.io/sh4tterh4nd/bigcontainers:latest

# Host port the application is published on.
BIGCONTAINERS_APP_PORT=8080

# Name shown in the UI and emails.
BIGCONTAINERS_APPLICATION_DISPLAY_NAME=BigContainers

# Public HTTPS origin operators use to reach this installation. Optional, but
# required (and validated as an absolute URL) once OIDC is enabled (Phase 1),
# since it is used to build absolute URLs including OIDC redirect URIs. Must
# match what a fronting reverse proxy actually serves; see README.md
# "Reverse proxy and TLS".
BIGCONTAINERS_APPLICATION_PUBLIC_BASE_URL=https://bigcontainers.example.com

# Leave unset (the default) for a production-oriented deployment: OpenAPI/
# Swagger UI are only enabled under the "dev" profile. Do not set this to
# "dev" outside local experimentation.
#SPRING_PROFILES_ACTIVE=

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=bigcontainers
POSTGRES_USER=bigcontainers
POSTGRES_PASSWORD=CHANGE_ME_strong_database_password

# --- Object storage (S3-compatible) --------------------------------------------
# BIGCONTAINERS_S3_* configures the production S3 media contract. Defaults
# target the bundled Garage service (BIGCONTAINERS_S3_ENDPOINT is left unset
# below so the compose file's http://garage:3900 default applies).
BIGCONTAINERS_S3_ENABLED=true
#
# To use an external S3-compatible endpoint instead of Garage:
#   1. Set COMPOSE_PROFILES above to an empty value (disables the garage
#      service and its volume).
#   2. Set BIGCONTAINERS_S3_ENDPOINT to the external endpoint (leave unset
#      for real AWS S3).
#   3. Set BIGCONTAINERS_S3_REGION, BIGCONTAINERS_S3_BUCKET, and the
#      access/secret keys issued by that provider.
#   4. Set BIGCONTAINERS_S3_PATH_STYLE_ACCESS=false for AWS S3; most
#      self-hosted S3-compatible services need it left at true.
#BIGCONTAINERS_S3_ENDPOINT=https://s3.example-external-provider.com
# "garage" is the region name baked into the committed garage.toml's
# [s3_api].s3_region - if you change one, change the other (see garage.toml).
# Set this to your real AWS region (e.g. eu-west-1) when using external S3.
BIGCONTAINERS_S3_REGION=garage
BIGCONTAINERS_S3_BUCKET=bigcontainers
BIGCONTAINERS_S3_PATH_STYLE_ACCESS=true

# Access/secret key pair for the bundled Garage bucket, created with
# `garage key create` during first-start setup (see README.md "Creating the
# Garage bucket and access key"). When using an external S3-compatible
# endpoint, set these to the access/secret key issued by that provider
# instead.
BIGCONTAINERS_S3_ACCESS_KEY=CHANGE_ME_access_key
BIGCONTAINERS_S3_SECRET_KEY=CHANGE_ME_strong_secret_key

# --- Bundled Garage object storage service -------------------------------------
# Cluster-internal secrets for the bundled Garage node - NOT the same as the
# BIGCONTAINERS_S3_* application-facing bucket credentials above. Generate
# with:
#   openssl rand -hex 32     # GARAGE_RPC_SECRET
#   openssl rand -base64 32  # GARAGE_ADMIN_TOKEN
GARAGE_RPC_SECRET=CHANGE_ME_run_openssl_rand_-hex_32
GARAGE_ADMIN_TOKEN=CHANGE_ME_run_openssl_rand_-base64_32

# Host ports for the bundled Garage S3 API and admin API. Unused when Garage
# is disabled.
GARAGE_S3_API_PORT=3900
GARAGE_ADMIN_PORT=3903

# --- Authentication (ADR-0003) ------------------------------------------------
# LOCAL_ONLY (default) or LOCAL_AND_OIDC. LOCAL_AND_OIDC still requires at
# least one enabled local Owner recovery account, and the application
# refuses to start if LOCAL_AND_OIDC is selected without a usable OIDC
# provider configuration below (issuer/client id/client secret).
BIGCONTAINERS_AUTHENTICATION_MODE=LOCAL_ONLY

# Owner-approved/preconfigured linking of an external identity to an
# existing local account is the safe default (ADR-0003). Setting this to
# true instead permits *automatic* linking by email, but only when the
# provider reports email_verified=true AND exactly one enabled internal user
# has that normalized email - ambiguous, missing, or unverified email claims
# always stop and require Owner assistance regardless of this setting. Leave
# this false unless you specifically want that automatic behavior.
BIGCONTAINERS_AUTHENTICATION_AUTO_LINK_BY_EMAIL=false

# OIDC provider placeholders. Required only when
# BIGCONTAINERS_AUTHENTICATION_MODE is LOCAL_AND_OIDC - all blank by default.
# The redirect/callback URI is derived from
# BIGCONTAINERS_APPLICATION_PUBLIC_BASE_URL; register it with the provider as
# <BIGCONTAINERS_APPLICATION_PUBLIC_BASE_URL>/login/oauth2/code/bigcontainers.
BIGCONTAINERS_OIDC_DISPLAY_NAME=
BIGCONTAINERS_OIDC_ISSUER_URI=
BIGCONTAINERS_OIDC_CLIENT_ID=
# Real secret - never commit a value here. Leave blank in this committed
# .env.example; only set it in your own untracked .env.
BIGCONTAINERS_OIDC_CLIENT_SECRET=
# Comma-separated. openid is required for OIDC login to function at all.
BIGCONTAINERS_OIDC_SCOPES=openid,profile,email

# --- Login rate limiting (ADR-0003) -------------------------------------------
# In-memory and per application instance - see README.md "Authentication and
# first Owner login" for what that means if you run more than one instance
# behind a load balancer.
BIGCONTAINERS_SECURITY_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# ISO-8601 duration.
BIGCONTAINERS_SECURITY_LOGIN_RATE_LIMIT_WINDOW=PT15M

# --- Seed data -----------------------------------------------------------------
# Name of the default organization created on first startup (see README.md
# "Migrations and first-run seeding").
BIGCONTAINERS_SEED_DEFAULT_ORGANIZATION_NAME=Default Organization

# First-run Owner bootstrap: this is how you get your first login. No Owner
# account is created unless BOTH BIGCONTAINERS_SEED_OWNER_USERNAME and
# BIGCONTAINERS_SEED_OWNER_PASSWORD are set - without them, there is no way
# to sign in after a first start. Set real values before your first
# `docker compose up`; see README.md "Authentication and first Owner login".
BIGCONTAINERS_SEED_OWNER_USERNAME=
# Real secret - never commit a value or log it. Leave blank here; only set
# it in your own untracked .env.
BIGCONTAINERS_SEED_OWNER_PASSWORD=
BIGCONTAINERS_SEED_OWNER_DISPLAY_NAME=Owner
BIGCONTAINERS_SEED_OWNER_EMAIL=
