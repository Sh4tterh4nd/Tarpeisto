{
  "name": "@tarpeisto/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/capture-openapi.mjs && openapi-typescript openapi/backend-openapi.json --output src/generated/backendOpenApi.generated.ts",
    "generate:committed": "openapi-typescript openapi/backend-openapi.json --output src/generated/backendOpenApi.generated.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
